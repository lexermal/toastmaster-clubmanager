# Public URL of this app (used in WhatsApp links and QR codes)
PUBLIC_URL=http://localhost:3000
# Public WordPress site (home, roles, membership, ...). WhatsApp messages link here.
WEBSITE_URL=https://malmo-tm.infinityfreeapp.com
# WordPress page with the meeting tools plugin (agenda, feedback forms). Linked from WhatsApp messages.
MEETING_PAGE_URL=

# Password for club officers (members, messaging, meetings)
ADMIN_PASSWORD=change-me
# Random string used to sign cookies and one-click role links
APP_SECRET=replace-with-a-long-random-string

# SQLite file + WhatsApp session live here
DATA_DIR=./data

# easy-Speak / tmclub.eu account. Must be a club officer so it can assign roles for members.
TMCLUB_USER=
TMCLUB_PASSWORD=
TMCLUB_CLUB_ID=
# When Cloudflare wants a human ("Verify you are human"), the worker opens a live view of its browser
# on this port. Expose it (HTTPS!) and put the public address here; officers get the link on WhatsApp.
TMCLUB_VERIFY_PORT=8732
TMCLUB_VERIFY_URL=
# Officers' WhatsApp numbers (comma-separated) for tmclub.eu alerts
ADMIN_PHONES=

# OpenAI: summaries of audience feedback in recaps
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5-mini

# Set to "false" to run the worker without connecting WhatsApp (messages stay in the outbox)
WHATSAPP_ENABLED=true

# WordPress site with the TM Meeting Tools plugin. The worker syncs meetings, members and roles from
# tmclub.eu into it, and e-mails speakers their feedback after a meeting. Leave empty to turn this off.
# WP_USER needs admin rights; create the password in wp-admin > Users > Profile > Application Passwords.
WP_URL=
WP_USER=
WP_APP_PASSWORD=
# Safety switch: easy-Speak user ids (comma-separated) that may receive feedback e-mails, "*" for all.
# Unset means only 112036 (Alex W.).
FEEDBACK_EMAIL_ALLOWED_TM_IDS=112036
